# fk-core minimal RV32 kernel config fragment (applied on top of tinyconfig)
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_EFI=n
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=n
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_BLK_DEV_INITRD=y
# set by Makefile: CONFIG_INITRAMFS_SOURCE
CONFIG_RD_GZIP=n
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=n
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_CMDLINE=""
CONFIG_MODULES=n
CONFIG_NET=n
CONFIG_BLOCK=n
CONFIG_DEBUG_KERNEL=n
CONFIG_LEGACY_PTYS=n
CONFIG_UNIX98_PTYS=n
